# Site public (sitemap + URLs canoniques). Reporte la même valeur dans `site` de site/astro.config.mjs.
SITE_URL=http://localhost:4321

# ── Convex — la base partagée par site/ et dashboard/ ──────────────────────────
# `npx convex dev`, lancé depuis dashboard/, écrit CONVEX_DEPLOYMENT LUI-MÊME : ne l'invente pas,
# lis-le après le premier lancement.
CONVEX_DEPLOYMENT=
# L'URL du déploiement. Les pages publiques la lisent AU BUILD (client serveur, dans le
# frontmatter .astro) : le préfixe `PUBLIC_` d'Astro veut dire « ce n'est pas un secret »,
# pas « va la chercher depuis le navigateur ».
PUBLIC_CONVEX_URL=

# ── Better Auth — dashboard/ UNIQUEMENT (le site public n'a ni compte ni session) ──
# ⚠️ En production, le secret ne vit PAS dans un fichier : `npx convex env set BETTER_AUTH_SECRET <valeur>`.
#    Ici, c'est une valeur de développement local. Génère-la (ex. `openssl rand -base64 32`), ne la recopie de nulle part.
BETTER_AUTH_SECRET=
# L'adresse publique du dashboard : http://localhost:3000 en local, https://admin.ton-domaine.fr en ligne.
BETTER_AUTH_URL=http://localhost:3000

# Formulaire de contact (Web3Forms — clé PUBLIQUE, ok côté client)
PUBLIC_WEB3FORMS_KEY=

# ⚠️ Copie ce fichier en .env et remplis les valeurs. Ne commit JAMAIS ton vrai .env.

# shadcnblocks — blocs pré-faits PRO (optionnel ; les blocs gratuits marchent SANS clé)
# npx shadcn add @shadcnblocks/<bloc>   (registry @shadcnblocks à déclarer dans components.json — /new-project, étape `07-scaffold.md`)
SHADCNBLOCKS_API_KEY=
