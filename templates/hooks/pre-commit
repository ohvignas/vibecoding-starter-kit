#!/usr/bin/env bash
# Pre-commit vibe-stack : bloque les secrets évidents. C'est TOUT ce que ce fichier fait — et
# c'est ce que le kit annonce partout ailleurs (« le scan de secrets du kit »).
#
# ⛔ NE REMETS PAS `npm run lint --if-present --silent || true` ICI. C'était un doublon MUET de la
# ligne de checks : `--silent || true` ne bloque rien, n'entre dans aucun décompte, et ne prouve
# jamais qu'elle a tourné. Mesuré sur une racine à deux workspaces : le linter entrait 2 fois dans
# site/ ET 2 fois dans dashboard/ par commit.
# La ligne de checks, elle, RAPPORTE : `⚠ check lint : problème détecté`, ou
# `⚠ check lint : n'a pas pu être lancé` si l'outil déclaré n'est pas installé. Et depuis que
# `needs` ne gate que le REPLI, un projet qui déclare son script `lint` le voit tourner pour de
# vrai — mesuré rc 0 sur les scaffolds des quatre stacks, qui posent tous eslint.
#
# Les checks de la stack (typecheck, lint…) sont ajoutés SOUS ce bloc par le kit, et ce sont eux
# qui rapportent : `⚠ check lint : problème détecté`.
set -e
if git diff --cached -U0 | grep -Eq '(sk-ant-[A-Za-z0-9_-]{20,}|sk-proj-[A-Za-z0-9_-]{20,}|sk-[a-zA-Z0-9]{20,}|sk_live_[A-Za-z0-9]{10,}|re_[A-Za-z0-9]{16,}|AIza[0-9A-Za-z_-]{35}|ghp_[A-Za-z0-9]{36}|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----)'; then
  echo "⛔ Secret potentiel détecté dans le diff — retire-le avant de commit."
  exit 1
fi
